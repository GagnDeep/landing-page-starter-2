{
  "name": "landing-page-starter",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 7811",
    "build": "next build",
    "start": "next start -p 7822",
    "lint": "eslint",
    "format": "prettier --write \"{app,hooks,lib,scripts}/**/*.{ts,tsx,css,mjs}\" \"components/*.tsx\"",
    "format:check": "prettier --check \"{app,hooks,lib,scripts}/**/*.{ts,tsx,css,mjs}\" \"components/*.tsx\"",
    "typecheck": "tsc --noEmit",
    "check:conventions": "node scripts/check-conventions.mjs",
    "check:guardrails": "node scripts/check-guardrails.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:conventions && pnpm run build",
    "verify:pr": "pnpm run verify && pnpm run check:guardrails",
    "pm2:start": "pnpm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "//": "typescript is pinned to 6.x and eslint to 9.x on purpose. TypeScript 7 is unsupported by typescript-eslint (see typescript-eslint#10940) and ESLint 10 breaks eslint-plugin-react 7.37.5, which eslint-config-next depends on. Bumping either turns `pnpm lint` into a hard crash."
  }
}
